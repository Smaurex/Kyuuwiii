<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Kyuuwiii.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False"
    Style="{StaticResource PageStyle}">

    <ScrollView>
        <VerticalStackLayout Padding="28,60,28,40" Spacing="0">

            <!--  Logo  -->
            <HorizontalStackLayout Margin="0,0,0,36" HorizontalOptions="Start">
                <Border
                    Margin="0,0,10,0"
                    BackgroundColor="{StaticResource Primary}"
                    HeightRequest="36"
                    StrokeThickness="0"
                    WidthRequest="36">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Image Source="kyuwii_logo.png" 
                           />
                </Border>
                <Label
                    FontAttributes="Bold"
                    FontSize="22"
                    Text="Kyuwii"
                    TextColor="{StaticResource TextPrimary}"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!--  Card  -->
            <Border Padding="28,32" Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="0">

                    <Label
                        Margin="0,0,0,8"
                        Style="{StaticResource HeadingStyle}"
                        Text="Welcome back" />
                    <Label
                        Margin="0,0,0,32"
                        Style="{StaticResource SubheadingStyle}"
                        Text="Please enter your academic credentials to continue." />

                    <!--  Email / Student ID  -->
                    <Label Style="{StaticResource LabelStyle}" Text="EMAIL OR STUDENT ID" />
                    <Border Style="{StaticResource InputBorderStyle}">
                        <Entry
                            x:Name="EmailEntry"
                            BackgroundColor="Transparent"
                            FontSize="15"
                            Keyboard="Email"
                            Placeholder="e.g. 2410xxxx"
                            PlaceholderColor="{StaticResource TextMuted}"
                            TextColor="{StaticResource TextPrimary}"
                            VerticalOptions="Center" />
                    </Border>

                    <!--  Password  -->
                    <Grid Margin="0,4,0,0">
                        <Label
                            HorizontalOptions="Start"
                            Style="{StaticResource LabelStyle}"
                            Text="PASSWORD"
                            VerticalOptions="Center" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="13"
                            HorizontalOptions="End"
                            Text="Forgot?"
                            TextColor="{StaticResource Accent}"
                            VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnForgotTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Border Margin="0,4,0,28" Style="{StaticResource InputBorderStyle}">
                        <Entry
                            x:Name="PasswordEntry"
                            BackgroundColor="Transparent"
                            FontSize="15"
                            IsPassword="True"
                            Placeholder="••••••••"
                            PlaceholderColor="{StaticResource TextMuted}"
                            TextColor="{StaticResource TextPrimary}"
                            VerticalOptions="Center" />
                    </Border>

                    <!--  Error label  -->
                    <Label
                        x:Name="ErrorLabel"
                        Margin="0,0,0,12"
                        FontSize="13"
                        HorizontalOptions="Center"
                        IsVisible="False"
                        TextColor="{StaticResource DangerColor}" />

                    <!--  Login button  -->
                    <Button
                        Clicked="OnLoginClicked"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Text="Login" />

                    <!--  Sign Up link  -->
                    <HorizontalStackLayout
                        Margin="0,24,0,0"
                        HorizontalOptions="Center"
                        Spacing="6">
                        <Label
                            FontSize="14"
                            Text="Don't have an account?"
                            TextColor="{StaticResource TextSecondary}" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="14"
                            Text="Sign Up"
                            TextColor="{StaticResource Accent}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSignUpTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!--  Footer  -->
            <HorizontalStackLayout
                Margin="0,32,0,0"
                HorizontalOptions="Center"
                Spacing="16">
                <Label
                    FontSize="12"
                    Text="University Registration System"
                    TextColor="{StaticResource TextMuted}" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
