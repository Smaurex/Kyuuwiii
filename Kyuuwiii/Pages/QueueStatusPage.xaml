<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Kyuuwiii.Pages.QueueStatusPage"
             Style="{StaticResource PageStyle}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Top Bar -->
        <Border Grid.Row="0" BackgroundColor="{StaticResource Surface}" StrokeThickness="0"
                Padding="20,52,20,16">
            <Grid>
                <HorizontalStackLayout HorizontalOptions="Start" Spacing="10">
                    <Border BackgroundColor="{StaticResource Primary}" StrokeThickness="0"
                            HeightRequest="28" WidthRequest="28">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6" />
                        </Border.StrokeShape>
                        <Label Text="K" TextColor="White" FontSize="16" FontAttributes="Bold"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="Kyuuwiii" TextColor="{StaticResource TextPrimary}"
                           FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Border HorizontalOptions="End" VerticalOptions="Center"
                    BackgroundColor="{StaticResource SurfaceVariant}"
                    StrokeThickness="0" HeightRequest="36" WidthRequest="36">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <Label x:Name="AvatarLabel" Text="?" TextColor="{StaticResource Accent}"
                       FontSize="14" FontAttributes="Bold"
                       HorizontalOptions="Center" VerticalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAvatarTapped" />
                    </Border.GestureRecognizers>
                </Border>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,24" Spacing="16">

                <!-- Status Tracker Card -->
                <Border BackgroundColor="{StaticResource Surface}"
                        Stroke="{StaticResource Accent}" StrokeThickness="2"
                        Padding="24,28">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#1A000000" Offset="0,4" Radius="12" Opacity="0.1" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="0">

                        <!-- Header row -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <Border BackgroundColor="{StaticResource AccentMint}" StrokeThickness="0"
                                    Padding="10,5" HorizontalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20" />
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="✔" TextColor="White" FontSize="12" VerticalOptions="Center" />
                                    <Label Text="Active Enrollment" TextColor="White" FontSize="12" FontAttributes="Bold" />
                                </HorizontalStackLayout>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                                <Label Text="TICKET NUMBER" TextColor="{StaticResource TextMuted}"
                                       FontSize="10" FontAttributes="Bold" HorizontalOptions="End" />
                                <Label x:Name="TicketLabel" Text="–"
                                       TextColor="{StaticResource Accent}"
                                       FontSize="30" FontAttributes="Bold" HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Grid>

                        <Label Text="Status Tracker" Style="{StaticResource HeadingStyle}" FontSize="32" />
                        <Label x:Name="OfficeName" Text="Admissions &amp; Enrollment Office"
                               Style="{StaticResource SubheadingStyle}" Margin="0,4,0,20" />

                        <BoxView HeightRequest="1" Color="{StaticResource CardBorder}" Margin="0,0,0,20" />

                        <!-- Position & Time -->
                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,24">
                            <VerticalStackLayout Grid.Column="0">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="👤" FontSize="14" />
                                    <Label Text="Your Position" TextColor="{StaticResource TextSecondary}" FontSize="13" />
                                </HorizontalStackLayout>
                                <Label x:Name="PositionLabel" Text="–"
                                       TextColor="{StaticResource TextPrimary}"
                                       FontSize="26" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="⏱" FontSize="14" />
                                    <Label Text="Est. Wait Time" TextColor="{StaticResource TextSecondary}" FontSize="13" />
                                </HorizontalStackLayout>
                                <Label x:Name="WaitTimeLabel" Text="–"
                                       TextColor="{StaticResource TextPrimary}"
                                       FontSize="26" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Progress bar -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                            <Label Text="Enrollment Progress" TextColor="{StaticResource Accent}"
                                   FontSize="14" FontAttributes="Bold" />
                            <Label x:Name="ProgressLabel" Grid.Column="1" Text="Waiting…"
                                   TextColor="{StaticResource Accent}" FontSize="14" FontAttributes="Bold" />
                        </Grid>
                        <ProgressBar x:Name="StatusProgress" Progress="0.1"
                                     ProgressColor="{StaticResource Accent}"
                                     BackgroundColor="{StaticResource CardBorder}"
                                     HeightRequest="10" Margin="0,0,0,8" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label x:Name="StatusLabel" Text="Waiting in queue…"
                                   TextColor="{StaticResource TextMuted}" FontSize="12" />
                            <Label x:Name="CheerLabel" Grid.Column="1" Text=""
                                   TextColor="{StaticResource Accent}" FontSize="12" FontAttributes="Bold" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- Queue Details Card -->
                <Border Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="Queue Details"
                               TextColor="{StaticResource TextPrimary}"
                               FontSize="20" FontAttributes="Bold" />

                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="16">
                            <Label Grid.Row="0" Grid.Column="0" Text="👥" FontSize="22"
                                   VerticalOptions="Center" Margin="0,0,14,0" />
                            <VerticalStackLayout Grid.Row="0" Grid.Column="1">
                                <Label x:Name="QueueLengthLabel" Text="–"
                                       TextColor="{StaticResource TextPrimary}"
                                       FontSize="20" FontAttributes="Bold" />
                                <Label Text="Waiting in total" Style="{StaticResource SubheadingStyle}" FontSize="13" />
                            </VerticalStackLayout>

                            <Label Grid.Row="1" Grid.Column="0" Text="⏱" FontSize="22"
                                   VerticalOptions="Center" Margin="0,0,14,0" />
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                                <Label Text="6 Minutes"
                                       TextColor="{StaticResource TextPrimary}"
                                       FontSize="20" FontAttributes="Bold" />
                                <Label Text="Average service time" Style="{StaticResource SubheadingStyle}" FontSize="13" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Leave queue button -->
                <Button Text="Leave Queue" Style="{StaticResource DangerButtonStyle}"
                        Clicked="OnLeaveQueueClicked"
                        Margin="0,4,0,16" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Nav (way gamit gng) 
        <Border Grid.Row="2" BackgroundColor="{StaticResource Surface}"
                StrokeThickness="0" Padding="0,12,0,28">
            <Grid ColumnDefinitions="*,*">
                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="4">
                    <Label Text="📋" FontSize="22" HorizontalOptions="Center" />
                    <Label Text="My Status" FontSize="11" FontAttributes="Bold"
                           TextColor="{StaticResource Accent}" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                    <Label Text="☰" FontSize="22" HorizontalOptions="Center"
                           TextColor="{StaticResource TextMuted}" />
                    <Label Text="Queues" FontSize="11"
                           TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </Border>
        -->
    </Grid>
</ContentPage>
